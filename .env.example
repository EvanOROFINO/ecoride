# Configuration de l'application
APP_NAME="EcoRide"
APP_ENV=development
APP_URL=http://localhost/ecoride
APP_DEBUG=true

# Base de données MySQL (relationnelle)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecoride
DB_USER=root
DB_PASSWORD=

# Base de données MongoDB (NoSQL)
MONGO_URI="mongodb://localhost:27017"
MONGO_DB=ecoride_nosql

# Sécurité
APP_SECRET="changez-moi-par-une-cle-aleatoire-de-32-caracteres-minimum"

# Configuration mail (pour notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@ecoride.fr
MAIL_FROM_NAME="EcoRide"
